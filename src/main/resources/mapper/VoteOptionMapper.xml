<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ent.happychat.mapper.VoteOptionMapper">

    <update id="changeVoteCount">
        UPDATE vote_option SET vote_count = GREATEST(vote_count + #{delta}, 0) WHERE id = #{id}
    </update>

</mapper>
